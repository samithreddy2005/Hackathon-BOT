## Example environment variables for ATS Resume Analyzer
# Copy this file to `.env` and fill in values.

# Telegram bot token (required)
BOT_TOKEN=

# Path to SQLite database file
DATABASE_PATH=database/ats_bot.db

# Optional: Groq API key to enable generative assistant (leave empty to run locally)
GROQ_API_KEY=

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
