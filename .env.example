# Copy this file to `.env` and fill in the values.
#   cp .env.example .env          (macOS / Linux)
#   Copy-Item .env.example .env   (Windows PowerShell)
#
# `.env` is git-ignored. Never commit real credentials.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Token issued by @BotFather on Telegram. Format: <digits>:<secret>
BOT_TOKEN=

# ---------------------------------------------------------------------------
# Storage (optional — sensible defaults shown)
# ---------------------------------------------------------------------------

# SQLite database file. Relative paths resolve against the project root.
DATABASE_PATH=database/ats_bot.db

# Where uploaded resumes are written before parsing.
UPLOAD_DIR=uploads

# Hours to keep uploaded files before deleting them. Extracted text stays in the
# database, so history and comparisons keep working. Set to 0 to keep files
# forever (not recommended — resumes are personal data).
UPLOAD_RETENTION_HOURS=24

# Largest file accepted, in megabytes.
MAX_UPLOAD_MB=20

# Fewest words a document must contain to be scored.
MIN_RESUME_WORDS=50

# ---------------------------------------------------------------------------
# Logging (optional)
# ---------------------------------------------------------------------------

# CRITICAL | ERROR | WARNING | INFO | DEBUG
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_TO_FILE=true

# ---------------------------------------------------------------------------
# Optional: LLM-backed assistant
# ---------------------------------------------------------------------------
# Leave GROQ_API_KEY empty to run fully offline. Free-form questions are then
# answered from the built-in knowledge base instead of a language model.
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_SECONDS=20
GROQ_MAX_TOKENS=900

# ---------------------------------------------------------------------------
# Optional: OCR
# ---------------------------------------------------------------------------
# Only needed if the Tesseract binary is not on PATH and not in a standard
# install location. Without Tesseract the bot still works — it just cannot read
# resumes sent as photos.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
