# ---------------------------------------------------------------------------
# Secrets — never commit these
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key

# ---------------------------------------------------------------------------
# User data — resumes are personal data and must stay out of version control
# ---------------------------------------------------------------------------
uploads/*
!uploads/.gitkeep
logs/*
!logs/.gitkeep
database/*
!database/.gitkeep
*.db
*.sqlite
*.sqlite3
*.sqlite3-journal
*.db-wal
*.db-shm

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
sdist/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
*.manifest
*.spec
pip-log.txt

# Virtual environments
.venv/
venv/
ENV/
env/

# ---------------------------------------------------------------------------
# Testing and type checking
# ---------------------------------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/
cover/
*.cover
.hypothesis/

# ---------------------------------------------------------------------------
# Editors and OS
# ---------------------------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
